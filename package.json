{
  "name": "gestao-financeira",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:api": "node scripts/ensure-db.mjs && json-server --watch db/db.json --port 3000",
    "db:reset": "node scripts/ensure-db.mjs --reset",
    "start:dev": "concurrently -k \"npm run start\" \"npm run start:api\"",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/cdk": "^22.2.5",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.5",
    "@angular/material-date-fns-adapter": "^22.2.5",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "chart.js": "^4.6.1",
    "date-fns": "^4.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.6.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.0",
    "json-server": "^0.17.4",
    "lint-staged": "^17.6.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  }
}
